# SaaS Manager API — example environment.
# Copy to `.env` for local development ONLY. Never commit `.env`.
# All values below are placeholders, not real credentials.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string (PostgreSQL 13+).
# Local example matching api/docker-compose.yml (development only):
DATABASE_URL=postgres://saas:change-me-local-only@localhost:5432/saas_manager_dev
# TLS to the database: false | true (encrypt, no cert check) | verify (encrypt + verify cert)
DATABASE_SSL=false

# Comma-separated API keys accepted as `Authorization: Bearer <key>`.
# Each key must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Several keys allow rotation without downtime.
API_KEYS=replace-with-a-generated-key-of-at-least-32-chars

# Comma-separated browser origins allowed by CORS (scheme://host[:port]).
# Leave empty for server-to-server use only (OpenClaw / MCP do not need CORS).
CORS_ORIGINS=

# Requests per window per client IP.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Set to true only when running behind a trusted reverse proxy / load balancer
# (needed so rate limiting sees real client IPs).
TRUST_PROXY=false

# Tests only: a disposable database whose name MUST end in "_test".
# TEST_DATABASE_URL=postgres://saas:change-me-local-only@localhost:5432/saas_manager_test
