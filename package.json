{
  "name": "@jers0nn/openclaw-saas-manager",
  "version": "1.1.0",
  "description": "OpenClaw plugin and agent Skill to manage SaaS customers, subscriptions and usage through the SaaS Manager REST API.",
  "license": "MIT",
  "author": "Jers0nn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jers0nn/openclaw-saas-manager.git"
  },
  "homepage": "https://github.com/Jers0nn/openclaw-saas-manager#readme",
  "bugs": {
    "url": "https://github.com/Jers0nn/openclaw-saas-manager/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "lobehub",
    "skill",
    "saas",
    "customers",
    "subscriptions"
  ],
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "dist/skills/**",
    "openclaw.plugin.json",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.35"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openclaw": "2026.9.8",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.35",
      "minGatewayVersion": "2026.8.35"
    },
    "build": {
      "openclawVersion": "2026.9.8",
      "pluginSdkVersion": "2026.9.8"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-skill.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  }
}
