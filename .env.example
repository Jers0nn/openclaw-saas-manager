# OpenClaw plugin — example environment variable for the SaaS Manager API key.
#
# The plugin itself reads its settings from OpenClaw config
# (plugins.entries.saas-manager.config). The recommended setup keeps the API
# key out of openclaw.json by referencing this environment variable through a
# SecretRef:  { "source": "env", "provider": "default", "id": "SAAS_MANAGER_API_KEY" }
#
# Placeholder only. Never commit a real key.
SAAS_MANAGER_API_KEY=replace-with-your-api-key

# Backend variables live in api/.env.example.
